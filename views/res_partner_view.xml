<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_ordermentum" model="ir.ui.view">
        <field name="name">res.partner.form.ordermentum</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <group name="ordermentum" string="Ordermentum" colspan="2">
                    <field name="ordermentum_purchaser_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
