<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="res_config_settings_view_form_ordermentum" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ordermentum.connector</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Ordermentum" string="Ordermentum" name="cs_ordermentum_connector">
                    <block title="Ordermentum" name="cs_ordermentum_connector_settings">
                        <setting help="Ordermentum auth base URL (default: https://app.ordermentum.com)">
                            <field name="ordermentum_auth_base_url" />
                        </setting>
                        <setting help="Ordermentum API base URL (default: https://app.ordermentum.com)">
                            <field name="ordermentum_api_base_url" />
                        </setting>
                        <setting help="Ordermentum username">
                            <field name="ordermentum_username" />
                        </setting>
                        <setting help="Ordermentum password">
                            <field name="ordermentum_password" password="True" />
                        </setting>
                        <setting help="Supplier UUID used to pull orders/invoices">
                            <field name="ordermentum_supplier_id" />
                        </setting>
                        <setting help="Default payment term used for imported orders">
                            <field name="ordermentum_default_payment_term_id" />
                        </setting>
                        <setting help="Default company for sale orders">
                            <field name="ordermentum_default_company_id"/>
                        </setting>
                        <setting help="Journal used to register payments when Ordermentum marks orders as paid">
                            <field name="ordermentum_payment_journal_id" domain="[('company_id', '=', ordermentum_default_company_id)]"/>
                        </setting>
                          <setting help="Auto confirm imported orders">
                            <field name="ordermentum_auto_confirm_orders" />
                        </setting>
                        <setting help="Auto create invoice">
                            <field name="ordermentum_auto_create_invoice" />
                        </setting>
                        <setting help="Auto post invoice">
                            <field name="ordermentum_auto_post_invoice" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_cs_ordermentum_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'cs_ordermentum_connector', 'bin_size': False}</field>
    </record>
</odoo>
